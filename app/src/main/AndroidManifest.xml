<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Not automotive-only: required=false so the same APK installs on phones and AAOS. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- Without this, Android's package-visibility filtering (enforced since API 30) hides
         the Wear OS companion app from our own process, confirmed via
         "MediaSessionManager: Package com.google.android.apps.wear.companion doesn't exist"
         logged from inside our app when the watch dispatched a pause/play/skip command. The
         OS-level relay (system_server) still delivers the call, but our own session can't
         resolve the calling package into a valid controller, so the command silently never
         reaches our callback at all. -->
    <queries>
        <package android:name="com.google.android.apps.wear.companion" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.EasyRadio">

        <!-- Declares this as an Android Auto / Automotive media app. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EasyRadio.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.EasyRadioPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Legacy media-button dispatch target. Remote/companion surfaces that relay this
             session's controls (e.g. Wear OS's system media card, Bluetooth AVRCP) need a
             registered receiver to deliver a button press to; without one, Pocket Casts'
             session (which registers one) renders enabled controls while ours renders all
             transport buttons greyed out and inert, confirmed side by side on a real device. -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Serves cached artwork to Auto/AAOS as local content:// uris. Exported
             so the Auto/AAOS host (a separate uid) can read the icons; it only
             returns cached image bytes for the requested url. -->
        <provider
            android:name=".playback.ArtworkContentProvider"
            android:authorities="com.easyradio.app.artwork"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- Home-screen widget showing what's currently playing. -->
        <receiver
            android:name=".widget.EasyRadioWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/easy_radio_widget_info" />
        </receiver>

        <!-- Receives playback commands from the paired Wear OS watch. -->
        <service
            android:name=".playback.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/easyradio/command" />
            </intent-filter>
        </service>

    </application>

</manifest>
